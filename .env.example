# Provider endpoint and model
OPENAI_COMPATIBLE_ADAPTER_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_ADAPTER_MODEL=provider/model

# The adapter reads the secret from the variable named here.
OPENAI_COMPATIBLE_ADAPTER_API_KEY_ENV=PROVIDER_API_KEY
PROVIDER_API_KEY=replace-with-your-secret

# Safe starting limits
OPENAI_COMPATIBLE_ADAPTER_MAX_TURNS=20
OPENAI_COMPATIBLE_ADAPTER_MAX_TOKENS=0
OPENAI_COMPATIBLE_ADAPTER_MAX_RETRIES=3
OPENAI_COMPATIBLE_ADAPTER_MAX_PROMPT_BYTES=2097152
OPENAI_COMPATIBLE_ADAPTER_REQUEST_TIMEOUT_MS=600000
OPENAI_COMPATIBLE_ADAPTER_COMMAND_TIMEOUT_MS=120000

# Optional: exact comma-separated relative paths for direct writes and patches.
# OPENAI_COMPATIBLE_ADAPTER_ALLOWED_FILES=src/index.ts,test/index.test.ts

# Optional: JSON object with additional provider headers.
# OPENAI_COMPATIBLE_ADAPTER_HEADERS_JSON={"X-Project":"example"}

# Optional for a trusted local endpoint without authentication.
# OPENAI_COMPATIBLE_ADAPTER_API_KEY_OPTIONAL=1
