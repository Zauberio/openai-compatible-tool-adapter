# Public example only. Do not commit real provider keys.
#
# ClawSweeper integration:
CODEX_BIN=clawsweeper-codex-adapter
CLAWSWEEPER_MODEL_BACKEND=codex-cli

# Provider mapping consumed by bin/clawsweeper-codex-adapter.mjs:
CLAWSWEEPER_OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
CLAWSWEEPER_OPENAI_COMPATIBLE_MODEL=provider/model
CLAWSWEEPER_OPENAI_COMPATIBLE_API_KEY_ENV=PROVIDER_API_KEY
PROVIDER_API_KEY=replace-me-outside-git

# Adapter limits:
CLAWSWEEPER_OPENAI_COMPATIBLE_MAX_TURNS=20
CLAWSWEEPER_OPENAI_COMPATIBLE_MAX_TOKENS=0
CLAWSWEEPER_OPENAI_COMPATIBLE_MAX_RETRIES=3
CLAWSWEEPER_OPENAI_COMPATIBLE_REQUEST_TIMEOUT_MS=600000
CLAWSWEEPER_OPENAI_COMPATIBLE_COMMAND_TIMEOUT_MS=120000
# CLAWSWEEPER_OPENAI_COMPATIBLE_ALLOWED_FILES=src/file.ts,test/file.test.ts

# Optional ClawSweeper evidence pack:
CLAWSWEEPER_REPAIR_EVIDENCE_PACK=1
CLAWSWEEPER_REPAIR_EVIDENCE_PACK_MAX_HUNKS=6
CLAWSWEEPER_REPAIR_EVIDENCE_PACK_MAX_HUNK_BYTES=12000
