# OpenAI-compatible tool adapter -- Octopus recipe environment template
#
# Copy this file to a secure location, fill in your provider details,
# and source it before starting Octopus.
#
# Do not commit secrets. Store real values in your secret manager,
# shell profile, or process supervisor unit.

# Provider endpoint
OPENAI_COMPATIBLE_ADAPTER_BASE_URL=https://api.example.com/v1

# Model identifier
OPENAI_COMPATIBLE_ADAPTER_MODEL=provider/model-name

# Name of the environment variable that holds the API key
OPENAI_COMPATIBLE_ADAPTER_API_KEY_ENV=MY_PROVIDER_API_KEY

# Optional: turn limits (0 = unlimited)
OPENAI_COMPATIBLE_ADAPTER_MAX_TURNS=20
OPENAI_COMPATIBLE_ADAPTER_MAX_TOKENS=0
OPENAI_COMPATIBLE_ADAPTER_MAX_RETRIES=3
OPENAI_COMPATIBLE_ADAPTER_REQUEST_TIMEOUT_MS=600000
OPENAI_COMPATIBLE_ADAPTER_COMMAND_TIMEOUT_MS=120000

# Optional: restrict write operations to specific files
# OPENAI_COMPATIBLE_ADAPTER_ALLOWED_FILES=src/index.ts,tests/index.test.ts
